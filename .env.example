# Supabase project — create at https://supabase.com/dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Feature flags (omit = enabled for LIVE_NOTES, SOCIAL, AUTHORITY; disabled for MARKETPLACE, WALLET)
VITE_FLAG_LIVE_NOTES=true
VITE_FLAG_SOCIAL=true
VITE_FLAG_MARKETPLACE=false
VITE_FLAG_WALLET=false
VITE_FLAG_AUTHORITY=true

# Optional: OpenAI key for Maya LLM layer (falls back to offline brain)
VITE_OPENAI_KEY=

# Optional: Google Maps key for the pin-picker (falls back to free Leaflet/OSM)
VITE_GOOGLE_MAPS_KEY=
