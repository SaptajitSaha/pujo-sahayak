# Normalise line endings so the repo is OS-agnostic. Critical for the Android
# project: android/gradlew is a POSIX shell script — a CRLF shebang breaks CI
# (Linux runners fail on `#!/bin/sh\r`). Everything text under android/ is
# Gradle/Java/XML and wants LF.
* text=auto eol=lf

# Windows-only batch helpers do want CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.jar binary
*.keystore binary
*.jks binary
*.aar binary
*.zip binary
