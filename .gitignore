# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# TypeScript / Vite caches
*.tsbuildinfo
.vite/
.eslintcache

# Env — never commit real keys; .env.example is tracked
.env
.env.local
.env.*.local

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Large screenshot intermediates (composited phone-*.png are tracked)
assets/screens/raw/

# Capacitor — native Android project IS committed (themed OS splash + high
# refresh-rate request live in android/). Build artifacts, gradle caches, copied
# web assets, and generated cordova-plugins are excluded by android/.gitignore.

# Downloaded CI build output
/apk

# Browser-subagent test artifacts — screenshots dropped at the repo root during
# verification passes. Never references from code; keep them out of the tree.
/screenshot-*.png
/maya-*.png
/nav-*.png
/.qoder-splash.png
