<?xml version="1.0" encoding="utf-8"?>
<!-- A 1dp transparent vector used as windowSplashScreenAnimatedIcon.
     Android 12+ defaults to showing the launcher icon inside a coloured
     circle on the OS splash; referencing a fully transparent icon makes the
     splash a solid dark window that flows seamlessly into our inline #boot.
     Using a real drawable (rather than @null) avoids OEMs that fall back to
     the launcher icon on @null. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="1dp"
    android:height="1dp"
    android:viewportWidth="1"
    android:viewportHeight="1">
    <path android:fillColor="#00000000" android:pathData="M0,0 L1,0 L1,1 L0,1 Z" />
</vector>
