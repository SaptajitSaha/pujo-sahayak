<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Window-level refresh-rate hint (API 23+). Value is a target in Hz;
             the OS picks the nearest supported mode. Applied alongside the
             runtime View.setRequestedFrameRate(HIGH) call in MainActivity. -->
        <item name="android:preferredRefreshRate">240</item>
    </style>


    <!-- Launch (OS) splash. Parent is androidx Theme.SplashScreen, which maps
         windowSplashScreen* to the native Android 12 SplashScreen API on 12+
         and back-ports to a legacy ImageView below that. Same #160E0A as the
         inline CSS boot in index.html → visually one continuous frame from
         OS-splash to WebView-painted boot. Transparent 1dp icon suppresses
         Android 12's default launcher-in-a-circle. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <!-- Pre-12 legacy path: the ImageView uses this as the window bg. -->
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:background">@color/splash_bg</item>
        <item name="android:preferredRefreshRate">240</item>
    </style>
</resources>
